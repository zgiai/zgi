{
  "$schema": "zgi.apperror.catalog/1",
  "version": 1,
  "status": "frozen",
  "envelope": {
    "http_and_sse_payload": [
      "code",
      "message",
      "params",
      "retryable",
      "error_id",
      "request_id"
    ],
    "legacy_fields_preserved": [
      "旧 numeric code",
      "X-ZGI-App-Error-Code",
      "SSE 事件名"
    ],
    "localization": [
      "zh-Hans",
      "en-US"
    ],
    "error_id": "在投影边界生成，写日志；前端可复制用于排查"
  },
  "errorinfo": {
    "type": "google.rpc.ErrorInfo",
    "reason": "等于 apperror.Code（domain.subject.reason）",
    "domain": "zgi.billing | zgi.llm | zgi.video | zgi.image | zgi.music",
    "metadata": [
      "error_id",
      "request_id",
      "retryable",
      "http_status",
      "operation"
    ],
    "optional_details": [
      "google.rpc.RequestInfo.request_id",
      "google.rpc.LocalizedMessage"
    ],
    "note": "Console→Pre 走 gRPC status + ErrorInfo；body 保留 error_code 兼容；浏览器只看到 Pre 投影后的 code"
  },
  "grpc_status_mapping": [
    {
      "grpc": "INVALID_ARGUMENT",
      "codes": [
        "billing.request.invalid",
        "llm.request.invalid",
        "video.request.invalid",
        "image.request.invalid"
      ]
    },
    {
      "grpc": "UNAUTHENTICATED",
      "codes": [
        "llm.api_key.invalid",
        "llm.api_key.expired",
        "llm.api_key.inactive"
      ]
    },
    {
      "grpc": "PERMISSION_DENIED",
      "codes": [
        "llm.model.forbidden"
      ]
    },
    {
      "grpc": "NOT_FOUND",
      "codes": [
        "billing.deduction.not_found",
        "llm.model.not_found",
        "video.task.not_found",
        "image.task.not_found",
        "music.task.not_found"
      ]
    },
    {
      "grpc": "ALREADY_EXISTS",
      "codes": [
        "image.task.conflict",
        "music.task.conflict"
      ]
    },
    {
      "grpc": "FAILED_PRECONDITION",
      "codes": [
        "billing.model.pricing_not_configured",
        "billing.deduction.mismatch",
        "billing.deduction.expired",
        "billing.actual_exceeds_reserve",
        "music.task.not_deletable"
      ]
    },
    {
      "grpc": "RESOURCE_EXHAUSTED",
      "codes": [
        "billing.organization.balance_insufficient",
        "billing.private_channel.balance_insufficient",
        "billing.workspace.quota_insufficient",
        "llm.quota.exceeded",
        "llm.balance.insufficient",
        "llm.provider.rate_limited",
        "llm.rate_limit.exceeded"
      ]
    },
    {
      "grpc": "DEADLINE_EXCEEDED",
      "codes": [
        "llm.provider.timeout",
        "video.upstream.timeout",
        "image.task.timeout"
      ]
    },
    {
      "grpc": "UNAVAILABLE",
      "codes": [
        "billing.exchange_rate.unavailable",
        "llm.provider.none_available",
        "llm.provider.unavailable",
        "llm.channel.private_unavailable",
        "llm.invocation.failed",
        "llm.provider.auth_failed",
        "video.task.failed",
        "video.runtime.unavailable",
        "image.upstream.failed",
        "music.model.unavailable"
      ]
    },
    {
      "grpc": "INTERNAL",
      "codes": [
        "billing.prededuct.failed",
        "billing.settle.failed",
        "video.asset.save_failed",
        "image.asset.save_failed",
        "image.runtime.failed",
        "music.task.failed"
      ]
    }
  ],
  "user_visible_classes": [
    {
      "class": "余额/额度不足",
      "codes": [
        "billing.organization.balance_insufficient",
        "billing.private_channel.balance_insufficient",
        "billing.workspace.quota_insufficient",
        "llm.quota.exceeded"
      ],
      "action": "充值 / 充值渠道 / 提升工作区额度 / 更换 API key",
      "retryable": false
    },
    {
      "class": "模型错误",
      "codes": [
        "llm.model.not_found",
        "llm.model.forbidden",
        "billing.model.pricing_not_configured",
        "llm.request.invalid"
      ],
      "action": "更换模型 / 申请权限 / 联系管理员配价",
      "retryable": false
    },
    {
      "class": "推理失败",
      "codes": [
        "llm.provider.none_available",
        "llm.provider.unavailable",
        "llm.channel.private_unavailable",
        "llm.invocation.failed",
        "llm.provider.timeout",
        "llm.provider.auth_failed",
        "llm.provider.rate_limited",
        "video.task.failed",
        "video.upstream.timeout",
        "video.runtime.unavailable",
        "image.upstream.failed",
        "image.task.timeout"
      ],
      "action": "重试 / 稍后重试 / 更换模型 / 联系管理员",
      "retryable": true
    },
    {
      "class": "系统计费失败",
      "codes": [
        "billing.prededuct.failed",
        "billing.settle.failed",
        "billing.exchange_rate.unavailable",
        "video.asset.save_failed",
        "image.asset.save_failed",
        "image.runtime.failed",
        "music.task.failed"
      ],
      "action": "重试 / 联系管理员（附 error_id）",
      "retryable": true
    }
  ],
  "compatibility": {
    "new_logs_use_new_codes_only": true,
    "old_logs_untouched_display_only": true,
    "new_tables": false,
    "reused_columns": [
      "llm_usage_bills.error_code",
      "llm_usage_bills.error_message"
    ]
  },
  "codes": [
