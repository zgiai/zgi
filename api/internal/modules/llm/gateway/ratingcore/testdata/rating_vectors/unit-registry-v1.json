  "metered_rule_override": {
    "per_quantity_overridable": true,
    "must_be_positive_integer": true,
    "applies_to": [
      "transcription",
      "speech_generation",
      "music_generation",
      "lyrics_generation",
      "video_generation"
    ]
  },
  "invariants": [
    "operation×meter 只能映射到一个 unit/base_unit",
    "unit 必须等于 metered base_unit",
    "per_1m_tokens 与 million_video_tokens 的 per_quantity 固定为 1000000",
    "除 per_1m_tokens/million_video_tokens 外，per_quantity 默认为 1，可由 metered 规则覆盖",
    "表外组合必须显式报错，禁止猜测或回退到其它 operation/meter"
  ],
