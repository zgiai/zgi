{
  "version": 1,
  "notes": "Each scenario runs as its own API end user. Sessions are separate conversations; the probe is a new conversation after all sessions. Checks are case-insensitive substring matches. requires_auto marks scenarios that only an automatic-capture configuration is expected to pass. observe marks scenarios whose expected outcome is a product decision; they are reported but not scored. Hard scenarios (difficulty: hard) add memory preloaded near slot limits ({{filler:N}} expands to neutral text), long update chains, precise forgetting, routing to slots (memory_in), duplicate detection (memory_max_occurrences), and whether remembered instructions are followed (answer_max_chars, answer_max_sentences).",
  "scenarios": [
    {
      "id": "explicit_allergy_zh",
      "category": "explicit",
      "sessions": [
        [
          "请记住：我对花生过敏。"
        ]
      ],
      "probe": "给我推荐一道适合我的晚餐，简短回答。",
      "expect": {
        "memory_all": [
          "花生"
        ],
        "answer_any": [
          "花生"
        ]
      }
    },
    {
      "id": "explicit_bullets_en",
      "category": "explicit",
      "sessions": [
        [
          "Please remember that I prefer answers as bullet points."
        ]
      ],
      "probe": "Give me three tips for better sleep.",
      "expect": {
        "memory_all": [
          "bullet"
        ],
        "answer_regex": "(?m)^\\s*([-*•]|\\d+\\.)\\s"
      }
    },
