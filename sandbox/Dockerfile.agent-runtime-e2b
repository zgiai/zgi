# syntax=docker/dockerfile:1

# E2B Build System 2.0 currently accepts a single-stage Dockerfile. Generate
# e2b-template-build/zgi-runtime-agent with `make prepare-agent-runtime-e2b`
# before building this template.
FROM python:3.13-slim-bookworm

ARG NODE_VERSION=22.23.3
ARG NODE_SHA256=df450af89261115ef9f9e3830c3eeb2cc9213b63c720b1af623cb5dcbe2e02de

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl xz-utils && \
    curl --fail --silent --show-error --location \
      "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
      --output /tmp/node.tar.xz && \
    echo "${NODE_SHA256}  /tmp/node.tar.xz" | sha256sum --check --strict && \
    tar --extract --xz --file /tmp/node.tar.xz --directory /usr/local --strip-components=1 && \
    rm -f /tmp/node.tar.xz && \
    apt-get purge -y --auto-remove curl xz-utils && \
    rm -rf /var/lib/apt/lists/*

COPY e2b-template-build /tmp/zgi-e2b-template
COPY scripts/agent-runtime-e2b-bootstrap.sh /usr/local/bin/zgi-runtime-agent-bootstrap

RUN install -m 0755 /tmp/zgi-e2b-template/zgi-runtime-agent /usr/local/bin/zgi-runtime-agent && \
    chmod 0755 /usr/local/bin/zgi-runtime-agent-bootstrap && \
    rm -rf /tmp/zgi-e2b-template && \
    groupadd --gid 65532 zgi-runtime && \
    useradd --uid 65532 --gid 65532 --create-home --home-dir /home/zgi-runtime \
      --shell /usr/sbin/nologin zgi-runtime && \
    mkdir -p /workspace /run/zgi-agent && \
    chown -R 65532:65532 /workspace /run/zgi-agent /home/zgi-runtime

ENV HOME=/home/zgi-runtime \
    PATH=/usr/local/bin:/usr/bin:/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    ZGI_RUNTIME_AGENT_WORKSPACE=/workspace \
    ZGI_RUNTIME_AGENT_LISTEN=tcp://0.0.0.0:49984 \
    ZGI_RUNTIME_AGENT_NETWORK_MODE=disabled \
    ZGI_RUNTIME_AGENT_TOKEN_FILE=/run/zgi-agent/bootstrap-token

USER zgi-runtime
WORKDIR /workspace
EXPOSE 49984
ENTRYPOINT ["/usr/local/bin/zgi-runtime-agent-bootstrap"]
