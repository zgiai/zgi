# Temporary local smoke-test image for the standalone Agent Runtime worker.
# The worker uses E2B in this test, so no host containerd socket is required.
FROM golang:1.26.2-bookworm AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/agentworker ./cmd/agentworker

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/agentworker /usr/local/bin/agentworker
RUN chmod 0755 /usr/local/bin/agentworker
EXPOSE 2670
ENTRYPOINT ["/usr/local/bin/agentworker"]
