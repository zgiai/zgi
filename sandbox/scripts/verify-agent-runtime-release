#!/usr/bin/env bash
set -euo pipefail

# Read-only Docker evidence. A tag or container Config.Image is not proof of the
# running content: inspect the actual image ID and its registry RepoDigests.
die() { printf '%s\n' "runtime-release: $*" >&2; exit 1; }
[[ $# == 3 ]] || die 'usage: verify-agent-runtime-release manifest.json api-container web-container'
manifest="$1"
[[ -f "$manifest" && ! -L "$manifest" ]] || die 'manifest must be a regular file'
(( $(stat -c %s "$manifest") <= 65536 )) || die 'manifest exceeds 64 KiB'
for command in jq docker; do command -v "$command" >/dev/null || die "missing command: $command"; done
jq -e 'type == "object" and .version == 1 and (.id | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"))
  and (.api_image | type == "string" and test("^[^[:space:]]+@sha256:[a-f0-9]{64}$"))
  and (.web_image | type == "string" and test("^[^[:space:]]+@sha256:[a-f0-9]{64}$"))' "$manifest" >/dev/null || die 'invalid release image pins'
verify_container() {
  local role="$1" container="$2" expected image state observed
  [[ "$container" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$ ]] || die 'container name/ID is invalid'
  expected="$(jq -er ".${role}_image" "$manifest")"
  state="$(docker container inspect --format '{{.State.Running}}' "$container")" || die "$role container is unavailable"
  [[ "$state" == true ]] || die "$role container is not running"
  image="$(docker container inspect --format '{{.Image}}' "$container")" || die "$role image is unavailable"
  [[ "$image" =~ ^sha256:[a-f0-9]{64}$ ]] || die "$role container returned an invalid image ID"
  observed="$(docker image inspect --format '{{json .RepoDigests}}' "$image")" || die "$role image digests are unavailable"
  jq -e --arg expected "$expected" 'type == "array" and index($expected) != null' <<<"$observed" >/dev/null || die "$role running image does not match the release pin"
  printf '%s\n' "runtime-release: $role image verified"
}
verify_container api "$2"
verify_container web "$3"
printf '%s\n' 'runtime-release: API/Web image evidence verified; Worker self-verification and provider template provenance are separate gates'
