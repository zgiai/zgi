# syntax=docker/dockerfile:1

FROM --platform=$BUILDPLATFORM golang:1.26.2-bookworm AS builder

ARG TARGETOS
ARG TARGETARCH
ARG GOPROXY=

WORKDIR /src
ENV GOPROXY=${GOPROXY}

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /out/zgi-runtime-agent ./cmd/runtimeagent

FROM node:22-bookworm-slim AS node-runtime

FROM python:3.13-slim-bookworm

COPY --from=node-runtime /usr/local/ /usr/local/
COPY --from=builder /out/zgi-runtime-agent /usr/local/bin/zgi-runtime-agent

RUN groupadd --gid 65532 zgi-runtime && \
    useradd --uid 65532 --gid 65532 --create-home --home-dir /home/zgi-runtime \
      --shell /usr/sbin/nologin zgi-runtime && \
    mkdir -p /workspace /run/zgi-agent && \
    chown -R 65532:65532 /workspace /run/zgi-agent /home/zgi-runtime

ENV HOME=/home/zgi-runtime \
    PATH=/usr/local/bin:/usr/bin:/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    ZGI_RUNTIME_AGENT_WORKSPACE=/workspace \
    ZGI_RUNTIME_AGENT_LISTEN=unix:///run/zgi-agent/runtime.sock \
    ZGI_RUNTIME_AGENT_NETWORK_MODE=disabled

USER 65532:65532
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/zgi-runtime-agent"]
