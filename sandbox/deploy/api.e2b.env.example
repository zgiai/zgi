# Add to the existing API environment. Use the same secret as the Worker.
ZGI_AGENT_RUNTIME_ENABLED=true
# Safe default: only organizations listed in APPROVED_PROFILES_JSON are admitted.
# Private deployments may explicitly use all_authenticated after review.
ZGI_AGENT_RUNTIME_ORG_MODE=allowlist
ZGI_AGENT_RUNTIME_URL=http://zgi-agentworker:2670
ZGI_AGENT_RUNTIME_API_KEY=replace-with-dedicated-worker-secret
ZGI_AGENT_RUNTIME_DEFAULT_PROFILE_ID=cc-codex-standard
ZGI_AGENT_RUNTIME_DEFAULT_POLICY_ID=package-install
ZGI_AGENT_RUNTIME_APPROVED_PROFILES_JSON={"cc-codex-standard":{"backend":"e2b","organization_ids":["replace-organization-id"],"policy_ids":["package-install"],"dependency_installation":true,"package_network_mode":"package-install"}}
