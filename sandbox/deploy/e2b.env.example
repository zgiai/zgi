# Copy to private e2b.env (chmod 600). Never commit the filled file.
ZGI_AGENT_RUNTIME_API_KEY=replace-with-dedicated-worker-secret
ZGI_AGENT_RUNTIME_DATABASE_URL=postgres://runtime:replace-password@postgres:5432/zgi_runtime?sslmode=disable
ZGI_AGENT_RUNTIME_E2B_API_KEY=replace-with-e2b-api-key
# An approved package template built with Dockerfile.agent-runtime-e2b-package.
# Template selection belongs to deployment, never to the Agent editor.
ZGI_AGENT_RUNTIME_E2B_PROFILES_JSON={"cc-codex-standard":{"template_id":"replace-approved-template-id","dependency_installation":true,"package_network_mode":"package-install","egress_allowed_hosts":["pypi.org","files.pythonhosted.org","registry.npmjs.org","deb.debian.org","security.debian.org"]}}
ZGI_AGENT_RUNTIME_MAX_WORKERS=1
