# Same-host native API example. A containerized API needs an approved private
# gateway; its localhost is NOT the native Worker host.
ZGI_AGENT_RUNTIME_ENABLED=true
ZGI_AGENT_RUNTIME_URL=http://127.0.0.1:2670
ZGI_AGENT_RUNTIME_API_KEY=replace-with-dedicated-worker-secret
ZGI_AGENT_RUNTIME_DEFAULT_PROFILE_ID=cc-codex-standard
ZGI_AGENT_RUNTIME_DEFAULT_POLICY_ID=package-install
ZGI_AGENT_RUNTIME_APPROVED_PROFILES_JSON={"cc-codex-standard":{"backend":"local-gvisor","organization_ids":["replace-organization-id"],"policy_ids":["package-install"],"dependency_installation":true,"package_network_mode":"package-install"}}
