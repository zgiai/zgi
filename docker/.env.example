COMPOSE_PROJECT_NAME=zgi
# Docker starts the complete local stack by default so first-time users can use
# knowledge base, code execution, and plugin features immediately.
# Set this to an empty value or run `./dev/start-docker --core` for the
# lightweight core stack.
COMPOSE_PROFILES=runtime,knowledge

# Docker build mirror defaults.
# Use `./dev/start-docker --china` to apply the recommended China mainland values
# for the current build without editing this file.
BUILD_REGION=global
APT_MIRROR=
APT_SECURITY_MIRROR=
APK_MIRROR=
NPM_REGISTRY=
PIP_INDEX_URL=
UV_INDEX_URL=
GOPROXY=

PUBLIC_PORT=2679
PUBLIC_URL=http://localhost:2679
# Optional public origin used for API callbacks such as Feishu events. Defaults
# to PUBLIC_URL when the API and web console share the same gateway.
CONSOLE_API_URL=
# Optional public origin used only for generated-file links delivered to
# external channels. Set this to the HTTPS gateway/tunnel that can reach ZGI.
FILES_PUBLIC_URL=
API_PORT=2670
WEB_PORT=2680
SANDBOX_PORT=2660
RUNNER_PORT=2665
POSTGRES_PORT=5434
REDIS_HOST_PORT=6381
WEAVIATE_PORT=18080
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Build-time Web metadata and branding. Rebuild the Web image after changing
# these values. Keywords are comma-separated.
NEXT_PUBLIC_APP_NAME=ZGI
NEXT_PUBLIC_APP_DESCRIPTION=
NEXT_PUBLIC_APP_KEYWORDS=
NEXT_PUBLIC_BRAND_NAME=zgi

# Reuse application images by default. Set IMAGE_TAG to a branch tag when
# multiple branches build images independently, or keep latest to reuse a
# previously built/pulled stack image.
API_IMAGE_NAME=docker.io/zgiai/zgi-api
WEB_IMAGE_NAME=zgi-web
SANDBOX_IMAGE_NAME=zgi-sandbox
RUNNER_IMAGE_NAME=zgi-runner
IMAGE_TAG=latest

POSTGRES_DB=zgi
POSTGRES_SQL_BASE_DB=zgi_sql_base
POSTGRES_RUNNER_DB=zgi_runner
POSTGRES_SANDBOX_DB=zgi_sandbox
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
REDIS_PASSWORD=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
SANDBOX_REDIS_DB=1

# Optional service wiring. The default values match the local stack.
VECTOR_STORE=weaviate
WEAVIATE_IMAGE=cr.weaviate.io/semitechnologies/weaviate:1.38.2
WEAVIATE_ENDPOINT=http://weaviate:8080
NEO4J_URI=bolt://neo4j:7687
CODE_EXECUTION_ENDPOINT=http://zgi-sandbox:2660
# Prebuilt profile used by Python data skills when runtime dependency builds are disabled.
CODE_EXECUTION_SYSTEM_DATA_PROFILE=scientific-data
PLUGIN_RUNNER_ENABLED=true
PLUGIN_RUNNER_URL=http://runner:2665

EDITION=SELF_HOSTED
CONSOLE_API_GRPC_ADDR=

MARKETPLACE_API_URL=https://market.zgiai.com
PM2_INSTANCES=2
WEB_API_CORS_ALLOW_ORIGINS=http://localhost:2679
CHAT_RUNTIME_MODEL_IDLE_TIMEOUT_SECONDS=300

# DigitalHuman public surfaces are controlled per published resource after
# an operator turns on each surface in the console.


# Native personal Connectors: required independent keyring.
CONNECTOR_CREDENTIAL_ACTIVE_KEY_ID=
CONNECTOR_CREDENTIAL_KEYS_JSON=
CONNECTOR_PLUGIN_DIRECTORIES_JSON=[]
