COMPOSE_PROJECT_NAME=zgi
# Docker starts the complete local stack by default so first-time users can use
# knowledge base, code execution, and plugin features immediately.
# Set this to an empty value or run `./dev/start-docker --core` for the
# lightweight core stack.
COMPOSE_PROFILES=runtime,knowledge

# Docker build mirror defaults.
# Use `./dev/start-docker --china` to apply the recommended China mainland values
# for the current build without editing this file.
BUILD_REGION=global
APT_MIRROR=
APT_SECURITY_MIRROR=
APK_MIRROR=
NPM_REGISTRY=
PIP_INDEX_URL=
UV_INDEX_URL=
GOPROXY=

PUBLIC_PORT=2679
PUBLIC_URL=http://localhost:2679
API_PORT=2670
WEB_PORT=2680
SANDBOX_PORT=2660
RUNNER_PORT=2665
POSTGRES_PORT=5434
REDIS_HOST_PORT=6381
WEAVIATE_PORT=18080

# Reuse application images by default. Set IMAGE_TAG to a branch tag when
# multiple branches build images independently, or keep latest to reuse a
# previously built/pulled stack image.
API_IMAGE_NAME=docker.io/zgiai/zgi-api
WEB_IMAGE_NAME=zgi-web
SANDBOX_IMAGE_NAME=zgi-sandbox
RUNNER_IMAGE_NAME=zgi-runner
IMAGE_TAG=latest

POSTGRES_DB=zgi
POSTGRES_SQL_BASE_DB=zgi_sql_base
POSTGRES_RUNNER_DB=zgi_runner
POSTGRES_SANDBOX_DB=zgi_sandbox
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SANDBOX_REDIS_DB=1

# Optional service wiring. The default values match the local stack.
VECTOR_STORE=weaviate
WEAVIATE_IMAGE=cr.weaviate.io/semitechnologies/weaviate:1.38.2
WEAVIATE_ENDPOINT=http://weaviate:8080
CODE_EXECUTION_ENDPOINT=http://zgi-sandbox:2660
PLUGIN_RUNNER_ENABLED=true
PLUGIN_RUNNER_URL=http://runner:2665

EDITION=SELF_HOSTED

MARKETPLACE_API_URL=https://market.zgiai.com
PM2_INSTANCES=2
WEB_API_CORS_ALLOW_ORIGINS=http://localhost:2679
CHAT_RUNTIME_MODEL_IDLE_TIMEOUT_SECONDS=300

# Keep disabled until the 32-byte API_KEY_ENCRYPTION_KEY is set in api/.env.docker.
# Add Exa credentials through an organization or personal Connection in the application.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=exa
WEB_SEARCH_ORG_DAILY_LIMIT=1000
EXA_TIMEOUT_SECONDS=20
EXA_MAX_RESULTS=10
EXA_DEFAULT_SEARCH_TYPE=auto
EXA_MAX_FETCH_URLS=5
EXA_MAX_CONTENT_CHARACTERS=20000
# Enable this for providers beyond Web Search. Web Search remains available
# when WEB_SEARCH_ENABLED=true even if this flag is false.
EXTERNAL_INTEGRATIONS_ENABLED=false
INTEGRATION_ORG_DAILY_LIMIT=1000
INTEGRATION_TIMEOUT_SECONDS=20
INTEGRATION_CREDENTIAL_ACTIVE_KEY_ID=
INTEGRATION_CREDENTIAL_KEYS_JSON=
INTEGRATION_HEALTH_FAILURE_THRESHOLD=3
INTEGRATION_OAUTH_REFRESH_WINDOW_SECONDS=600
INTEGRATION_OAUTH_FLOW_TTL_SECONDS=600
INTEGRATION_OAUTH_CALLBACK_URL=http://localhost:2679/console/api/integrations/oauth/callback
INTEGRATION_OAUTH_RESULT_URL=http://localhost:3000/console/integrations/oauth/result
# Optional deployment fallback; organization-owned OAuth apps can be configured in the UI.
INTEGRATION_OAUTH_CLIENTS_JSON=
